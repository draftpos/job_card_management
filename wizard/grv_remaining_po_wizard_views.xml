<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grv_remaining_po_wizard_form" model="ir.ui.view">
        <field name="name">grv.remaining.po.wizard.form</field>
        <field name="model">grv.remaining.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Source Remaining Items from New Supplier">
                <group>
                    <field name="purchase_id" readonly="1"/>
                    <field name="picking_id" readonly="1" invisible="1"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="remaining_qty" readonly="1" force_save="1"/>
                        <field name="new_qty"/>
                        <field name="new_supplier_id"/>
                        <field name="unit_price"/>
                    </list>
                </field>
                <footer>
                    <button string="Create Purchase Orders" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
