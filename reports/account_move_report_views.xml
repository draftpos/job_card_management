<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_custom_invoice_document">
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <t t-call="web.basic_layout">
                <div class="header">
                    <div class="row mb-2">
                        <div class="col-12 text-center">
                            <h2 style="font-weight: bold; text-transform: uppercase; color: #1a1a2e; margin: 0; letter-spacing: 1px; font-size: 24px;">
                                <t t-if="o.is_insurance_invoice">Insurance Invoice</t>
                                <t t-elif="o.move_type in ('in_invoice', 'in_refund', 'in_receipt')">Purchase Invoice</t>
                                <t t-else="">Sales Invoice</t>
                                <t t-if="o.name != '/'"> <span t-field="o.name"/></t>
                            </h2>
                        </div>
                    </div>
                    <div class="row align-items-center" style="margin-bottom: 20px;">
                        <div class="col-6">
                            <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height: 80px;" alt="Logo"/>
                            <h3 t-else="" style="color: #1a1a2e; font-weight: bold;"><span t-field="res_company.name"/></h3>
                        </div>
                        <div class="col-6 text-end" style="font-size: 14px; color: #555;">
                            <div style="font-weight: bold; color: #1a1a2e; font-size: 16px;"><span t-field="res_company.name"/></div>
                            <div t-if="res_company.street"><span t-field="res_company.street"/></div>
                            <div>
                                <t t-if="res_company.city"><span t-field="res_company.city"/></t>
                                <t t-if="res_company.country_id">, <span t-field="res_company.country_id.name"/></t>
                            </div>
                            <div t-if="res_company.phone">Phone: <span t-field="res_company.phone"/></div>
                            <div t-if="res_company.email">Email: <span t-field="res_company.email"/></div>
                            <div t-if="res_company.custom_vat"><strong>VAT NO: </strong> <span t-field="res_company.custom_vat"/> </div>
                            <div t-if="res_company.custom_tin"><strong>TIN NO: </strong> <span t-field="res_company.custom_tin"/> </div>
                        </div>
                    </div>
                </div>
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.7; letter-spacing: 0.4px; color: #333; margin-top: 0px !important; padding-top: 60px !important;">
                    
                    <div class="row mt-1 mb-3" style="margin-top: 0px !important; padding-top: 0px !important;">
                        <div class="col-6">
                            <div t-if="o.partner_id" style="font-size: 14px; height: 100%; margin-right: 10px;">
                                <strong>
                                    <t t-if="o.move_type in ('in_invoice', 'in_refund', 'in_receipt')">Vendor Details:</t>
                                    <t t-else="">Customer Details:</t>
                                </strong><br/>
                                <span t-field="o.partner_id.name"/><br/>
                                <t t-if="o.partner_id.street"><span t-field="o.partner_id.street"/><br/></t>
                                <t t-if="o.partner_id.city"><span t-field="o.partner_id.city"/><t t-if="o.partner_id.country_id">, <span t-field="o.partner_id.country_id.name"/></t><br/></t>
                                <t t-if="o.partner_id.phone">Phone: <span t-field="o.partner_id.phone"/><br/></t>
                                <t t-if="o.partner_id.email">Email: <span t-field="o.partner_id.email"/></t>
                            </div>
                        </div>
                        <div class="col-6">
                            <div style="height: 100%; margin-left: 10px;">
                                <table class="table table-sm table-borderless mb-0" style="border: none;">
                                <tr t-if="o.invoice_origin">
                                    <td style="border: none; padding: 4px 10px; font-weight: bold; font-size: 14px;">Job Card Ref:</td>
                                    <td class="text-end" style="border: none; padding: 4px 10px; font-size: 14px;"><span t-field="o.invoice_origin"/></td>
                                </tr>
                                <tr>
                                    <td style="border: none; padding: 4px 10px; font-weight: bold; font-size: 14px;">Invoice Date:</td>
                                    <td class="text-end" style="border: none; padding: 4px 10px; font-size: 14px;"><span t-field="o.invoice_date"/></td>
                                </tr>
                                <tr t-if="o.invoice_date_due">
                                    <td style="border: none; padding: 4px 10px; font-weight: bold; font-size: 14px;">Due Date:</td>
                                    <td class="text-end" style="border: none; padding: 4px 10px; font-size: 14px;"><span t-field="o.invoice_date_due"/></td>
                                </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Lines Table -->
                    <table class="table o_main_table table-borderless mb-0" id="invoice_table" style="border: none; width: 100%;">
                        <thead>
                            <tr style="border-bottom: 3px solid #000 !important;">
                                <th name="th_description" class="text-start" style="border: none; padding: 16px 14px; font-size: 14px; font-weight: 700; color: #1a1a2e; letter-spacing: 0.6px; text-transform: uppercase;">Description</th>
                                <th name="th_quantity" class="text-end" style="border: none; padding: 16px 14px; font-size: 14px; font-weight: 700; color: #1a1a2e; letter-spacing: 0.6px; text-transform: uppercase;">Quantity</th>
                                <th name="th_priceincl" class="text-end" style="border: none; padding: 16px 14px; font-size: 14px; font-weight: 700; color: #1a1a2e; letter-spacing: 0.6px; text-transform: uppercase;">Price Incl</th>
                                <th name="th_discount" class="text-end" style="border: none; padding: 16px 14px; font-size: 14px; font-weight: 700; color: #1a1a2e; letter-spacing: 0.6px; text-transform: uppercase;">Disc %</th>
                                <th name="th_tax_amount" class="text-end" style="border: none; padding: 16px 14px; font-size: 14px; font-weight: 700; color: #1a1a2e; letter-spacing: 0.6px; text-transform: uppercase;">VAT</th>
                                <th name="th_subtotal" class="text-end" style="border: none; padding: 16px 14px; font-size: 14px; font-weight: 700; color: #1a1a2e; letter-spacing: 0.6px; text-transform: uppercase;">Total (Incl)</th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))" t-as="line">
                                <tr>
                                    <td style="border: none; border-bottom: 1px solid #e0e0e0; padding: 14px 14px; font-size: 15px; color: #333; letter-spacing: 0.4px;">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td class="text-end" style="border: none; border-bottom: 1px solid #e0e0e0; padding: 14px 14px; font-size: 15px; color: #333; letter-spacing: 0.4px;">
                                        <span t-esc="'{:.2f}'.format(line.quantity)"/>
                                    </td>
                                    <td class="text-end" style="border: none; border-bottom: 1px solid #e0e0e0; padding: 14px 14px; font-size: 15px; color: #333; letter-spacing: 0.4px;">
                                        $ <span t-esc="'{:.2f}'.format((line.price_total / line.quantity) if line.quantity else 0.0)"/>
                                    </td>
                                    <td class="text-end" style="border: none; border-bottom: 1px solid #e0e0e0; padding: 14px 14px; font-size: 15px; color: #333; letter-spacing: 0.4px;">
                                        <span t-esc="'{:.2f}'.format(line.discount)"/>%
                                    </td>
                                    <td class="text-end" style="border: none; border-bottom: 1px solid #e0e0e0; padding: 14px 14px; font-size: 15px; color: #333; letter-spacing: 0.4px;">
                                        $ <span t-esc="'{:.2f}'.format(line.price_total - line.price_subtotal)"/>
                                    </td>
                                    <td class="text-end o_price_total" style="border: none; border-bottom: 1px solid #e0e0e0; padding: 14px 14px; font-size: 15px; font-weight: 700; color: #1a1a2e; letter-spacing: 0.4px;">
                                        $ <span t-esc="'{:.2f}'.format(line.price_total)"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totals -->
                    <!-- Footer Section -->
                    <div class="row mt-4 mb-2" style="padding: 10px; page-break-inside: avoid;">
                        <!-- Signatures and Bank Details (Left/Center) -->
                        <div class="col-6">
                            <div class="mb-4">
                                <div style="margin-bottom: 10px;"><strong>Received by</strong> <span style="display:inline-block; width:200px; border-bottom: 1px dashed #333;"></span></div>
                                <div style="margin-bottom: 10px;"><strong>Date</strong> <span style="display:inline-block; width:254px; border-bottom: 1px dashed #333;"></span></div>
                                <div style="margin-bottom: 10px;"><strong>Signed</strong> <span style="display:inline-block; width:240px; border-bottom: 1px dashed #333;"></span></div>
                            </div>
                            
                            <div class="row mt-4" style="font-size: 13px;">
                                <div class="col-6">
                                    <div t-if="res_company.hao_bank_name"><strong>Bank Name</strong> <span class="float-end" t-field="res_company.hao_bank_name"/></div>
                                    <div t-if="res_company.hao_bank_branch"><strong>Branch</strong> <span class="float-end" t-field="res_company.hao_bank_branch"/></div>
                                </div>
                                <div class="col-6">
                                    <div t-if="res_company.hao_bank_account_name"><strong>Account Name</strong> <span class="float-end" t-field="res_company.hao_bank_account_name"/></div>
                                    <div t-if="res_company.hao_bank_account_no"><strong>Account No</strong> <span class="float-end" t-field="res_company.hao_bank_account_no"/></div>
                                </div>
                            </div>
                        </div>
                        <!-- Totals (Right) -->
                        <div class="col-6">
                            <table class="table table-sm table-borderless" style="border: none;">
                                <tr class="o_subtotal">
                                    <td style="border: none; padding: 6px 12px; font-size: 15px; color: #333;">Sub Total (Excl) USD</td>
                                    <td class="text-end" style="border: none; padding: 6px 12px; font-size: 15px; color: #333;">
                                        $ <span t-esc="'{:.2f}'.format(o.amount_untaxed)"/>
                                    </td>
                                </tr>
                                <tr class="o_taxes">
                                    <td style="border: none; padding: 6px 12px; font-size: 15px; color: #333;">VAT Amount USD</td>
                                    <td class="text-end" style="border: none; padding: 6px 12px; font-size: 15px; color: #333;">
                                        $ <span t-esc="'{:.2f}'.format(o.amount_tax)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: none; padding: 6px 12px; font-size: 15px; font-weight: bold; color: #1a1a2e;">Sub Total (Incl) USD</td>
                                    <td class="text-end" style="border: none; padding: 6px 12px; font-size: 15px; font-weight: bold; color: #1a1a2e;">
                                        $ <span t-esc="'{:.2f}'.format(o.amount_total)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: none; padding: 6px 12px; font-size: 15px; color: #333;">Discount USD</td>
                                    <td class="text-end" style="border: none; padding: 6px 12px; font-size: 15px; color: #333;">
                                        <!-- Calculate total discount from lines -->
                                        $ <t t-set="total_discount" t-value="sum(l.price_unit * l.quantity * (l.discount / 100.0) for l in o.invoice_line_ids)"/>
                                        <span t-esc="'{:.2f}'.format(total_discount)"/>
                                    </td>
                                </tr>
                                <tr class="o_total" style="border-top: 1px solid #1a1a2e;">
                                    <td style="border: none; padding: 12px 12px; font-size: 17px; font-weight: 700; color: #1a1a2e;"><strong>Invoice Total (Incl) USD</strong></td>
                                    <td class="text-end" style="border: none; padding: 12px 12px; font-size: 17px; font-weight: 700; color: #1a1a2e;">
                                        <strong>$ <span t-esc="'{:.2f}'.format(o.amount_total)"/></strong>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Terms and Conditions -->
                    <div class="row mt-4" t-if="o.narration">
                        <div class="col-12">
                            <h5 style="color: #1a1a2e; font-weight: bold; border-bottom: 2px solid #1a1a2e; padding-bottom: 5px;">Terms and Conditions</h5>
                            <div style="font-size: 13px; color: #555; padding-top: 10px; line-height: 1.1;">
                                <span t-out="o.narration"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
        
        <template id="report_custom_invoice">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-call="job_card_management.report_custom_invoice_document" t-lang="lang"/>
                </t>
            </t>
        </template>

        <record id="action_report_custom_invoice" model="ir.actions.report">
            <field name="name">Custom Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">job_card_management.report_custom_invoice</field>
            <field name="report_file">job_card_management.report_custom_invoice</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="attachment">(object.state == 'posted') and ((object.name or 'INV').replace('/','_')+'.pdf')</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
