<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_cost_form" model="ir.ui.view">
        <field name="name">job.cost.form</field>
        <field name="model">job.cost</field>
        <field name="arch" type="xml">
            <form string="Job Cost">
                <header>
                    <button name="%(job_card_management.action_report_job_cost)d" type="action" string="Print Job Cost" class="oe_highlight"/>
                    <button name="compute_costs" type="object" string="Recompute Costs"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_card_id" readonly="1"/>
                            <field name="total_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost Breakdown" name="cost_breakdown">
                            <field name="cost_line_ids">
                                <list string="Cost Lines">
                                    <field name="category"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_job_cost_tree" model="ir.ui.view">
        <field name="name">job.cost.tree</field>
        <field name="model">job.cost</field>
        <field name="arch" type="xml">
            <list string="Job Costs">
                <field name="name"/>
                <field name="job_card_id"/>
                <field name="total_cost"/>
            </list>
        </field>
    </record>

    <record id="action_job_cost" model="ir.actions.act_window">
        <field name="name">Job Costs</field>
        <field name="res_model">job.cost</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
