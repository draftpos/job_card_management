<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procurement_reject_wizard_form" model="ir.ui.view">
        <field name="name">procurement.reject.wizard.form</field>
        <field name="model">procurement.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject">
                <group>
                    <field name="procurement_id" invisible="1"/>
                    <field name="reject_type" invisible="1"/>
                    <field name="reason" placeholder="Please provide a detailed reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_reject" string="Confirm Reject" type="object" class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
